# ──────────────────────────────────────────────────────────────────────────────
# AW GYMS - ENVIRONMENT CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────

# ─── Backend Configuration ─────────────────────────────────────────────────────
# Application identifier (can be any unique string)
APP_ID=awgyms-app

# Secret key for JWT/token signing (min 32 characters, use strong random value)
# Generate: `openssl rand -base64 32` or `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`
APP_SECRET=your-very-secret-key-min-32-characters-long

# ─── Database Configuration ───────────────────────────────────────────────────
# MySQL connection string supporting:
# - Local MySQL: mysql://user:password@localhost:3306/awgyms
# - PlanetScale: mysql://[username]:[password]@[host]/[database]?ssl={"rejectUnauthorized":true}
# - Vercel MySQL: mysql://[user]:[password]@[host]/[database]
DATABASE_URL=mysql://user:password@localhost:3306/awgyms

# ─── Server Configuration ──────────────────────────────────────────────────────
# Port for Node.js server (Vercel manages this automatically in production)
PORT=3000

# Node environment (development, production, testing)
NODE_ENV=development

# ─── Features ──────────────────────────────────────────────────────────────────
# Enable CORS (usually true)
ENABLE_CORS=true

# CORS origin (comma-separated list of allowed origins)
CORS_ORIGIN=https://awgyms.com,https://www.awgyms.com,http://localhost:3000,http://localhost:5173
