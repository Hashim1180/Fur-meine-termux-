{
  "version": 2,
  "env": {
    "APP_ID": "@app-id",
    "APP_SECRET": "@app-secret",
    "DATABASE_URL": "@database-url"
  },
  "installCommand": "cd app && npm ci --no-audit --prefer-offline --no-fund --no-progress",
  "buildCommand": "cd app && npm run vercel-build",
  "outputDirectory": "app/dist"
}
